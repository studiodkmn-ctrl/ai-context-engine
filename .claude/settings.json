{
  "_comment": "AI Context v6.0 — Auto-generated. SessionStart+UserPromptSubmit Hooks laufen in ALLEN Claude-Umgebungen (Terminal, VS Code, Cursor, JetBrains).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f _ai_context/scripts/ai-context-doctor.sh ] && bash _ai_context/scripts/ai-context-doctor.sh --session 2>&1 || true"
          },
          {
            "type": "command",
            "command": "[ -f _ai_context/scripts/ai-session-prep.sh ] && bash _ai_context/scripts/ai-session-prep.sh 2>&1 | awk '/^(🧠|✅|__AI_CTX__)/ || /Session bereit/ || /Kontext wird vorbereitet/' || true"
          },
          {
            "type": "command",
            "command": "cat _ai_context/_SESSION.md 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "if [ -f ~/.ai-context/_ai_context_template/scripts/ai-context-selfcheck.sh ]; then bash ~/.ai-context/_ai_context_template/scripts/ai-context-selfcheck.sh --session 2>&1 || true; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f ~/.ai-context/hooks/pii-warn.sh ]; then bash ~/.ai-context/hooks/pii-warn.sh; fi"
          },
          {
            "type": "command",
            "command": "[ -f _ai_context/scripts/ai-prompt-router.sh ] && bash _ai_context/scripts/ai-prompt-router.sh || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f _ai_context/scripts/ai-read-guard.sh ] && bash _ai_context/scripts/ai-read-guard.sh || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f _ai_context/scripts/ai-session-reflect.sh ] && bash _ai_context/scripts/ai-session-reflect.sh || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f _ai_context/scripts/ai-session-reflect.sh ] && bash _ai_context/scripts/ai-session-reflect.sh || true"
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "_ai_context/**",
    "_ai_context_template/**"
  ]
}