#!/usr/bin/env bash
# =============================================================================
# post-commit hook — AI Context Auto-Invalidation v8.0.1
#
# FIXES vs v5 (die Invalidierung war seit v5 vollständig wirkungslos):
#   - invalidate_index schrieb das _idx/*.md-Muster (| `file` | ✅ |, Spalte 2)
#     in _ai_index.md, das Spalte 3 mit 🟢/🟡/🔴 nutzt → alle Aufrufe No-Ops.
#     Jetzt: _idx/*.md UND _ai_index.md, jeweils im passenden Format.
#   - Ziel backend/api.md existierte nicht (kanonisch: backend/endpoints.md)
#   - Schubladen-Splits (X_core.md/X_extended.md) werden mit invalidiert
#   - Fingerprint-seds trafen v4-Zeilen; jetzt Git:/Session: + Staleness-Block
#   - portable_md5: Pipe maskierte den Exit-Code, Fallback lief nie
# =============================================================================

CONTEXT_DIR="./_ai_context"
[ ! -d "$CONTEXT_DIR" ] && exit 0

# -M50% to detect renames (both old + new paths flow through the rules below)
RAW_DIFF=$(git diff -M50% --name-status HEAD~1 HEAD 2>/dev/null \
        || git diff -M50% --name-status HEAD 2>/dev/null)
CHANGED=$(awk -F'\t' '$1 ~ /^R/ { print $2; print $3; next } { for(i=2;i<=NF;i++) print $i }' <<< "$RAW_DIFF")
[ -z "$CHANGED" ] && exit 0

# Für die Invalidierungsregeln: Änderungen am Kontext-System selbst ausblenden.
# Sonst markiert JEDER Commit Projektkontext als veraltet — "_ai_context/" endet
# auf "context/" und trifft die State-Regel, "hooks/post-commit" trifft "hooks/".
# Das fiel bis v8.0.0 nicht auf, weil die Invalidierung ohnehin wirkungslos war.
# $CHANGED bleibt vollständig (Fingerprints, Changelog, Registry brauchen alles).
CHANGED_CODE=$(printf '%s\n' "$CHANGED" \
  | grep -vE '^(_ai_context|_ai_context_template)/|^hooks/|^\.claude/' || true)

YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
TODAY=$(date +"%Y-%m-%d")
INDEX="$CONTEXT_DIR/_ai_index.md"
TEMP="$CONTEXT_DIR/_temp_notes.md"

# macOS-portable Hash-Funktion
# FIX: Die Pipe maskierte den Exit-Code (cut liefert immer 0), daher lief der
# md5-Fallback nie und auf Stock-macOS ohne md5sum kam ein leerer String heraus.
portable_md5() {
  # Fehlende Datei => Exit 1, damit der Aufrufer per || auf die Alternativdatei
  # (requirements.txt) ausweichen kann.
  [ -f "$1" ] || return 1
  local out
  if out=$(md5sum "$1" 2>/dev/null) || out=$(md5 -r "$1" 2>/dev/null); then
    printf '%s' "$out" | cut -d' ' -f1
  else
    echo "n/a"
  fi
}

# ---- Multi-Fingerprint update ----
NEW_HASH=$(git log -1 --format="%H")
NEW_MSG=$(git log -1 --format="%s")

PKG_HASH=$(portable_md5 package.json 2>/dev/null || portable_md5 requirements.txt 2>/dev/null || echo "n/a")
SCHEMA_HASH=$(portable_md5 prisma/schema.prisma 2>/dev/null || echo "n/a")
ENV_EXISTS=$([ -f .env ] && echo "yes" || echo "no")

if [ -f "$INDEX" ]; then
  # FIX: Der Index nutzt seit v6 "Git:"/"Session:" im ## Projekt-Block.
  # "Last known git hash:"/"Last session date:" sind v4/v5-Legacy und existieren
  # in neuen Projekten nicht mehr — beide Varianten anfassen, die jeweils nicht
  # vorhandene ist ein harmloser No-Op.
  sed -i.bak "s#^Git:.*#Git:      $NEW_HASH#" "$INDEX"
  sed -i.bak "s#^Session:.*#Session:  $TODAY#" "$INDEX"
  sed -i.bak "s#Last known git hash:.*#Last known git hash:    $NEW_HASH#" "$INDEX"
  sed -i.bak "s#Last session date:.*#Last session date:      $TODAY#" "$INDEX"
  rm -f "${INDEX}.bak"

  # FIX: pkg/schema/.env-Fingerprints wurden berechnet, aber in Zeilen geschrieben,
  # die es im Index nicht gibt — sie landeten nirgends. Der Template-Index
  # deklariert dafür einen "## ⚡ Staleness"-Block als "automatisch befüllt durch
  # post-commit Hook"; implementiert war das nie. Jetzt schon.
  INDEX="$INDEX" PKG_HASH="$PKG_HASH" SCHEMA_HASH="$SCHEMA_HASH" \
  ENV_EXISTS="$ENV_EXISTS" TODAY="$TODAY" python3 << 'PYEOF' 2>/dev/null || true
import os, re, pathlib
p = pathlib.Path(os.environ["INDEX"])
text = p.read_text(encoding="utf-8")
block = (
    "## ⚡ Staleness\n```\n"
    f"pkg:      sha256:{os.environ['PKG_HASH']}\n"
    f"schema:   sha256:{os.environ['SCHEMA_HASH']}\n"
    f".env:     {os.environ['ENV_EXISTS']}\n"
    f"geprüft:  {os.environ['TODAY']}\n"
    "```"
)
new = re.sub(r"## ⚡ Staleness\n```\n.*?\n```", block, text, count=1, flags=re.S)
if new != text:
    p.write_text(new, encoding="utf-8")
PYEOF
fi

# ---- Invalidation function ----
# FIX (v8.0.1): Das Muster "| `file` | ✅ |" passt auf die Domain-Indizes
# (_idx/*.md, Status in Spalte 2) — angewandt wurde es aber auf _ai_index.md,
# das "| `file` | Enthält | 🟢 | Datum |" nutzt (Status in Spalte 3). Deshalb
# waren ALLE invalidate_index-Aufrufe stille No-Ops.
# Entscheidend sind die _idx/*.md: deren Status landet via ai-session-prep.sh
# in _SESSION.md und damit tatsächlich beim Agenten.
INVALIDATED=()

# Invalidiert genau einen Index-Eintrag. Exit 0 = etwas geändert, 1 = nichts gefunden.
_invalidate_one() {
  local context_file="$1"
  local new_marker="$2"
  local hit=false

  local escaped
  escaped=$(echo "$context_file" | sed 's/\//\\\//g')

  # --- 1. Domain-Indizes (_idx/*.md): | `file` | ✅ | → | `file` | ❌ | ---
  # Über alle Domain-Indizes laufen statt eine Zuordnung zu pflegen — so
  # greifen auch selbst angelegte Schubladen ohne Änderung an dieser Stelle.
  local idx
  for idx in "$CONTEXT_DIR"/_idx/*.md; do
    [ -f "$idx" ] || continue
    grep -q "| \`${context_file}\` |" "$idx" 2>/dev/null || continue

    sed -i.bak "s/| \`${escaped}\` | ✅ |/| \`${escaped}\` | ${new_marker} |/" "$idx"
    # Eskalation: ⚠️ → ❌, aber nie ❌ → ⚠️
    if [ "$new_marker" = "❌" ]; then
      sed -i.bak "s/| \`${escaped}\` | ⚠️ |/| \`${escaped}\` | ${new_marker} |/" "$idx"
    fi
    rm -f "${idx}.bak"
    hit=true
  done

  # --- 2. Hauptindex (_ai_index.md): Status in Spalte 3 + Datum in Spalte 4 ---
  # Gleiche Semantik wie ai-session-prep.sh (die einzige Stelle, die das Format
  # bisher korrekt getroffen hat): 🟢/🟡 → 🔴 bzw. 🟢 → 🟡, nie zurückstufen.
  if [ -f "$INDEX" ] && grep -q "| \`${context_file}\` |" "$INDEX" 2>/dev/null; then
    local main_marker="🟡"
    [ "$new_marker" = "❌" ] && main_marker="🔴"
    INDEX="$INDEX" CTX_FILE="$context_file" MARKER="$main_marker" \
    STAMP="$(date +%d.%m)" python3 << 'PYEOF' 2>/dev/null || true
import os, re, pathlib
p = pathlib.Path(os.environ["INDEX"])
text = p.read_text(encoding="utf-8")
marker, stamp = os.environ["MARKER"], os.environ["STAMP"]
pat = re.compile(
    r"(\|\s*`" + re.escape(os.environ["CTX_FILE"]) + r"`\s*\|[^|]*\|\s*)([^|]+?)(\s*\|\s*)([^|]+?)(\s*\|)"
)
def sub(m):
    cur = m.group(2).strip()
    # Nie zurückstufen: 🔴 bleibt 🔴, wenn nur eine Warnung ansteht.
    if cur == "🔴" and marker != "🔴":
        return m.group(0)
    return f"{m.group(1)}{marker}{m.group(3)}{stamp}{m.group(5)}"
new = pat.sub(sub, text, count=1)
if new != text:
    p.write_text(new, encoding="utf-8")
PYEOF
    hit=true
  fi

  $hit || return 1
  return 0
}

invalidate_index() {
  local context_file="$1"
  local new_marker="$2"
  # FIX: Nach einem Schubladen-Split (ai-context-drawer.sh) steht im Index nicht
  # mehr X.md, sondern X_core.md / X_extended.md. Ohne diese Kandidaten liefe die
  # Invalidierung ausgerechnet nach jedem Split wieder ins Leere.
  local base="${context_file%.md}"
  local target
  for target in "$context_file" "${base}_core.md" "${base}_extended.md"; do
    if _invalidate_one "$target" "$new_marker"; then
      INVALIDATED+=("$target → $new_marker")
    fi
  done
  return 0
}

# ---- Apply rules (stack-agnostic) ----
# Schema / DB
echo "$CHANGED_CODE" | grep -qiE 'prisma/schema|models\.py|migration' && {
  invalidate_index "backend/database.md" "❌"
  invalidate_index "backend/endpoints.md" "⚠️"
}

# API routes
echo "$CHANGED_CODE" | grep -qiE 'src/app/api/|routers/|routes/|views\.py|urls\.py' && \
  invalidate_index "backend/endpoints.md" "❌"

# Components / UI
echo "$CHANGED_CODE" | grep -qiE 'src/components/|\.tsx$|\.jsx$' && \
  invalidate_index "frontend/components.md" "❌"

echo "$CHANGED_CODE" | grep -qiE 'src/app/' && \
  invalidate_index "frontend/components.md" "⚠️"

# State
echo "$CHANGED_CODE" | grep -qiE 'store/|context/|lib/store|hooks/' && \
  invalidate_index "frontend/state.md" "❌"

# Auth
echo "$CHANGED_CODE" | grep -qiE 'middleware\.|auth\.' && {
  invalidate_index "backend/endpoints.md" "❌"
  invalidate_index "frontend/state.md" "⚠️"
}

# Config — nur bei strukturellen Änderungen invalidieren, nicht bei reinen Version-Bumps
echo "$CHANGED_CODE" | grep -qiE 'package\.json|requirements\.txt|pyproject\.toml' && {
  IS_VERSION_BUMP=false
  if echo "$CHANGED" | grep -q "package.json"; then
    # Prüfe ob ausschließlich das "version" Feld geändert wurde
    PKG_DIFF=$(git diff HEAD~1 HEAD -- package.json 2>/dev/null | grep '^[+-]' | grep -v '^[+-][+-][+-]' || echo "")
    CHANGED_KEYS=$(echo "$PKG_DIFF" | grep -oE '"[a-zA-Z_-]+"' | sort -u | tr '\n' ',' | tr -d '"')
    if [ "$CHANGED_KEYS" = "version," ] || [ "$CHANGED_KEYS" = "version" ]; then
      IS_VERSION_BUMP=true
    fi
  fi
  if ! $IS_VERSION_BUMP; then
    invalidate_index "architecture.md" "⚠️"
    invalidate_index "decisions.md" "⚠️"
  fi
}

echo "$CHANGED_CODE" | grep -qiE 'tailwind\.config' && \
  invalidate_index "frontend/components.md" "⚠️"

echo "$CHANGED_CODE" | grep -qiE 'next\.config|vite\.config' && \
  invalidate_index "architecture.md" "⚠️"

echo "$CHANGED_CODE" | grep -qiE '\.env' && \
  invalidate_index "backend/endpoints.md" "⚠️"

# ---- Update _temp_notes.md ----
if [ -f "$TEMP" ]; then
  sed -i.bak "s#Last change:.*#Last change:   ${TODAY} — ${NEW_MSG}#" "$TEMP"
  rm -f "${TEMP}.bak"
fi

# ---- Letzte Änderungen (max 5) ----
# FIX: Angehängt wurde an "## 📝 Quick Change Log" — diese Überschrift gibt es im
# Index nicht (real: "## 📝 Letzte Änderungen (max 5)"), der Eintrag landete also
# nie. Zusätzlich hätte das alte sed die Zeile VOR den ```-Fence gesetzt und den
# Block zerlegt. Das dokumentierte Limit von 5 Einträgen wird jetzt durchgesetzt.
if [ -f "$INDEX" ]; then
  CHANGED_SUMMARY=$(echo "$CHANGED" | head -3 | tr '\n' ', ' | sed 's/,$//')
  INDEX="$INDEX" LOG_LINE="- ${TODAY}: ${NEW_MSG} (${CHANGED_SUMMARY})" \
  python3 << 'PYEOF' 2>/dev/null || true
import os, re, pathlib
p = pathlib.Path(os.environ["INDEX"])
text = p.read_text(encoding="utf-8")
line = os.environ["LOG_LINE"]
# Beide Überschriften akzeptieren: v6+ und die alte v5-Variante.
m = re.search(
    r"(## 📝 (?:Letzte Änderungen|Quick Change Log)[^\n]*\n```\n)(.*?)(\n?```)",
    text, flags=re.S,
)
if m:
    old = [l for l in m.group(2).splitlines()
           if l.strip() and not l.strip().startswith("- [DATE]")]
    entries = [line] + [e for e in old if e != line]
    text = text[:m.start()] + m.group(1) + "\n".join(entries[:5]) + m.group(3) + text[m.end():]
    p.write_text(text, encoding="utf-8")
PYEOF
fi

# ---- Auto-Trim (v5.2 — Priority-Based, nie P1 löschen) ----
python3 << 'PYEOF'
import re, pathlib, sys

ctx = pathlib.Path("./_ai_context")
if not ctx.exists():
    sys.exit(0)

# Wissensdateien mit Eintragslimits
# Format: Einträge sind ``` ... ``` Blöcke mit ID: oder RULE: als erste Zeile darin
knowledge_files = {"_gotchas.md": 15, "debug_patterns.md": 15, "security.md": 10, "testing.md": 10, "playbooks.md": 15}

def get_priority(block_text):
    """Lese P: Feld aus einem Eintrag. Default: 2 (rückwärtskompatibel)."""
    m = re.search(r'\nP:\s*([123])', block_text)
    return int(m.group(1)) if m else 2

def priority_trim(content, max_entries, fname):
    """Trimmt Einträge nach Priorität: P3 zuerst, dann P2. P1 niemals löschen."""
    # Finde Header (alles vor dem ersten ``` Block mit ID:/RULE:)
    # Eintrag-Format: ``` \nID: ... \n ... ```  oder  ``` \nRULE: ... \n ... ```
    block_pattern = re.compile(r'```\s*\n(?:ID:|RULE:|PLAYBOOK:)[\s\S]*?```', re.MULTILINE)
    entries = block_pattern.findall(content)

    if len(entries) <= max_entries:
        return content, 0  # Nichts zu tun

    # Splits: header, [entries...], footer
    first_match = block_pattern.search(content)
    header = content[:first_match.start()] if first_match else ""
    last_match = list(block_pattern.finditer(content))[-1]
    footer = content[last_match.end():]

    # Sortiere nach Priorität (P1 sichern, dann P2, dann P3)
    p1 = [e for e in entries if get_priority(e) == 1]
    p2 = [e for e in entries if get_priority(e) == 2]
    p3 = [e for e in entries if get_priority(e) == 3]

    kept = list(p1)  # P1: immer behalten
    remaining = max_entries - len(kept)

    # P2: neueste behalten (Ende der Liste = neueste)
    if remaining > 0:
        kept += p2[-remaining:] if len(p2) > remaining else p2
        remaining = max_entries - len(kept)

    # P3: nur wenn noch Platz
    if remaining > 0:
        kept += p3[-remaining:] if len(p3) > remaining else p3

    removed = len(entries) - len(kept)
    new_content = header + "\n".join(kept) + footer
    return new_content, removed

for fname, max_entries in knowledge_files.items():
    fpath = ctx / fname
    if not fpath.exists():
        continue
    content = fpath.read_text(encoding="utf-8")
    new_content, removed = priority_trim(content, max_entries, fname)
    if removed > 0:
        fpath.write_text(new_content, encoding="utf-8")
        print(f"  Trim {fname}: {removed} P3/P2-Einträge entfernt (P1 erhalten)")

# _temp_notes.md: Recent Changes max 5 (unverändert)
temp_path = ctx / "_temp_notes.md"
if temp_path.exists():
    content = temp_path.read_text(encoding="utf-8")
    lines = content.splitlines()
    in_changes = False
    change_lines = []
    other_lines = []
    for line in lines:
        if "Recent Changes" in line:
            in_changes = True
            other_lines.append(line)
        elif in_changes and re.match(r'^\[20\d\d-', line.strip()):
            change_lines.append(line)
        elif in_changes and line.startswith("## "):
            in_changes = False
            other_lines.append(line)
        else:
            other_lines.append(line)
    if len(change_lines) > 5:
        result = []
        for line in other_lines:
            result.append(line)
            if "Recent Changes" in line:
                result.extend(change_lines[-5:])
        content = "\n".join(result) + "\n"
        temp_path.write_text(content, encoding="utf-8")

    # FIX (v8.0.2): memory_save (type=note) haengt jeden Fakt als freie
    # "- ... (YYYY-MM-DD) <!-- hash:... -->"-Zeile an (mcp/src/lib/save.ts).
    # Der obige Trim erfasst nur den strukturierten "Recent Changes"-Block
    # (Zeilen "[YYYY-...") -- diese freien Zeilen wuchsen unbegrenzt weiter,
    # weil sie nirgends gekappt wurden. Kappung: neueste 10 behalten (10
    # statt der 15 bei den Wissensdateien -- _temp_notes.md traegt
    # zusaetzlich den strukturierten Recent-Changes-Block, 15 freie
    # Eintraege hätten die 600-Token-Grenze trotzdem gerissen).
    note_pattern = re.compile(r'^- .+<!-- hash:[0-9a-f]+ -->\s*$', re.MULTILINE)
    note_lines = note_pattern.findall(content)
    if len(note_lines) > 10:
        kept = set(note_lines[-10:])
        out_lines = []
        for line in content.splitlines():
            if note_pattern.match(line) and line not in kept:
                continue
            out_lines.append(line)
        # Mehrfache Leerzeilen (durch entfernte Eintraege) auf eine reduzieren
        cleaned = re.sub(r'\n{3,}', '\n\n', "\n".join(out_lines))
        temp_path.write_text(cleaned.rstrip() + "\n", encoding="utf-8")
        print(f"  Trim _temp_notes.md: {len(note_lines) - 10} alte memory_save-Eintraege entfernt")
PYEOF

# ---- Schubladen-Check (Overflow-Management) ----
DRAWER_SCRIPT="$CONTEXT_DIR/scripts/ai-context-drawer.sh"
[ -f "$DRAWER_SCRIPT" ] && bash "$DRAWER_SCRIPT" > /dev/null 2>&1 || true

# ---- Registry v6.0: Aktualisieren + RAG-Cache-Invalidierung ----
REGISTRY_SCRIPT="$CONTEXT_DIR/scripts/ai-context-registry.sh"
REGISTRY_FILE="$CONTEXT_DIR/registry.yaml"
RAG_CACHE_SCRIPT="$CONTEXT_DIR/scripts/ai-rag-cache.sh"
if [ -f "$REGISTRY_SCRIPT" ] && [ -f "$REGISTRY_FILE" ]; then

  # Alte Chunk-Hashes vor --scan merken (für Cache-Invalidierung)
  OLD_HASHES=""
  if [ -f "$REGISTRY_FILE" ]; then
    OLD_HASHES=$(grep 'hash:' "$REGISTRY_FILE" | sed "s/.*hash:[ ]*//;s/['\"]//g" | sort || true)
  fi

  # Neue ID:-Blöcke verankern, dann Registry neu einlesen
  bash "$REGISTRY_SCRIPT" --add-anchors > /dev/null 2>&1 || true
  bash "$REGISTRY_SCRIPT" --scan > /dev/null 2>&1 || true

  # Neue Hashes ermitteln; nur geänderte invalidieren
  if [ -f "$REGISTRY_FILE" ] && [ -f "$RAG_CACHE_SCRIPT" ]; then
    NEW_HASHES=$(grep 'hash:' "$REGISTRY_FILE" | sed "s/.*hash:[ ]*//;s/['\"]//g" | sort || true)
    # Hashes die in OLD_HASHES aber nicht in NEW_HASHES sind → invalidieren
    while IFS= read -r old_hash; do
      [ -z "$old_hash" ] && continue
      # Präfix "sha1:" aus dem Hash-Wert entfernen für den Vergleich
      hash_val="${old_hash#sha1:}"
      if ! printf '%s\n' "$NEW_HASHES" | grep -qF "$hash_val"; then
        bash "$RAG_CACHE_SCRIPT" --invalidate "$old_hash" > /dev/null 2>&1 || true
      fi
    done <<< "$OLD_HASHES"
  fi
fi

# ---- Interaction Map regenerieren (v6.5 — bei UI-Änderungen) ----
if echo "$CHANGED" | grep -qiE '\.(tsx|jsx|vue|svelte)$|src/components/|src/app/|src/pages/'; then
  MAP_SCRIPT="$CONTEXT_DIR/scripts/ai-context-map.sh"
  [ -f "$MAP_SCRIPT" ] && bash "$MAP_SCRIPT" > /dev/null 2>&1 || true
fi

# ---- Cross-Projekt-Transfer: neue Chunks an andere Projekte verteilen (Pro only) ----
if [ "$(cat "$HOME/.ai-context/edition" 2>/dev/null)" = "pro" ]; then
  TRANSFER_SCRIPT="$CONTEXT_DIR/scripts/ai-context-transfer.sh"
  [ -f "$TRANSFER_SCRIPT" ] && bash "$TRANSFER_SCRIPT" --detect > /dev/null 2>&1 || true
fi

# ---- Auto-regenerate _SESSION.md ----
PREP_SCRIPT="$CONTEXT_DIR/scripts/ai-session-prep.sh"
if [ -f "$PREP_SCRIPT" ]; then
  bash "$PREP_SCRIPT" > /dev/null 2>&1 || true
fi

# ---- MCP Auto-Capture (Phase 2): Wissen aus dem Commit-Diff ins Gedächtnis ----
# Schlanke CLI statt MCP-Handshake. Bricht den Commit nie ab (|| true).
# v7: Repo-lokaler Build hat Vorrang (im ai-context-engine-Repo selbst ist
# der aktueller als die globale Install-Kopie) — sonst global.
CAPTURE_CLI=""
for _cand in "$CONTEXT_DIR/../mcp/dist/capture-cli.js" "$HOME/.ai-context/mcp/dist/capture-cli.js"; do
  [ -f "$_cand" ] && CAPTURE_CLI="$_cand" && break
done
if [ -n "$CAPTURE_CLI" ] && command -v node > /dev/null 2>&1; then
  ( cd "$(git rev-parse --show-toplevel 2>/dev/null || echo .)" \
      && node "$CAPTURE_CLI" --apply "HEAD~1..HEAD" ) > /dev/null 2>&1 || true
fi

# ---- Output ----
if [ ${#INVALIDATED[@]} -gt 0 ]; then
  echo ""
  echo -e "${CYAN}🔄 AI Context v5 — Auto-Invalidation:${NC}"
  for item in "${INVALIDATED[@]}"; do
    echo -e "   ${YELLOW}⚠  ${item}${NC}"
  done
  echo -e "   ${CYAN}_SESSION.md regeneriert${NC}"
  echo ""
fi

exit 0
